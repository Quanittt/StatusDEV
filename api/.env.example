# Локально development. Без значення сервер працює в режимі production (https-вебхуки, без Swagger, без seed).
NODE_ENV=development
DATABASE_URL="postgresql://postgres:123456@localhost:5432/statusdev"
PORT=3001
WEB_URL="http://localhost:5173"
# мінімум 32 символи, наприклад: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string-32chars"
# публічна адреса API (на проді обов'язково, напр. https://api.example.com)
#API_URL="http://localhost:3001"

# R2' variables
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=statusdev-files

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM=

# Нагадування про дедлайни: інтервал перевірки в хвилинах (0 = вимкнено)
#REMINDERS_INTERVAL_MINUTES=60

# Telegram-бот для сповіщень власнику (токен від @BotFather). Без нього канал вимкнений.
#TELEGRAM_BOT_TOKEN=

# Помилки сервера в Sentry (необов'язково)
#SENTRY_DSN=

# Дублювати логи у файл (необов'язково; `npm run dev` пише в logs/api.log сам)
#LOG_FILE=logs/api.log

# Swagger UI на /docs: за замовчуванням увімкнено, окрім production
#DOCS_ENABLED=true

# За reverse proxy (nginx, Cloudflare, балансувальник): довіряти X-Forwarded-For для IP клієнта.
# Без цього ліміти запитів і IP підпису документів показуватимуть адресу проксі.
#TRUST_PROXY=true
