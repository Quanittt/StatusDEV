generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Status {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  value     String
  note      String?
  updatedAt DateTime @updatedAt

  @@unique([userId])
}
